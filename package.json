{
  "name": "lexus-obd-flex",
  "version": "0.9.4",
  "private": true,
  "type": "module",
  "description": "Paikallinen Lexus IS220d- ja CT 200h OBD Flex -diagnostiikka, automaattinen VIN- ja ajoneuvotunnistus, vaihdettavat teemat, CT 200h -ostotarkastus sekä GPS/OBD-tehotesti vLinker MC+ Classic/BLE-, Quicklynks FFF6- ja yleisille ELM327-adaptereille",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:bom": "node scripts/validate-bom-diagnostics.mjs",
    "build": "node scripts/build-apk.mjs",
    "preview": "npx nitron dev",
    "version:next": "node scripts/next-version.mjs",
    "release:check": "node scripts/verify-release.mjs check",
    "release:verify": "node scripts/verify-release.mjs verify",
    "release:register": "node scripts/verify-release.mjs register"
  },
  "devDependencies": {
    "aaptjs3": "^2.0.2",
    "adm-zip": "0.5.16",
    "apktool": "2.0.3",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "nitron": "1.3.0"
  }
}
